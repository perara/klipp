{
  "name": "klipp",
  "version": "0.2.0",
  "description": "A paperclip that lives in your web app while you build it: point at what looks wrong, and it reads the code behind it and files the GitHub issue.",
  "license": "MIT",
  "author": "Per-Arne Andersen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perara/klipp.git"
  },
  "keywords": [
    "vite-plugin",
    "debugging",
    "bug-report",
    "react",
    "devtools"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p examples/react-app/tsconfig.json",
    "test": "vitest run --maxWorkers=2",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run format && npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "example": "npm run build && vite examples/react-app",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@babel/parser": "^7.29.7",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
